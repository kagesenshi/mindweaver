      "itemId": 1,
      "name": "username",
      "type": "string",
      "mandatory": true,
      "label": "Superset Username"
    },
    {
      "itemId": 2,
      "name": "password",
      "type": "password",
      "mandatory": true,
      "label": "Superset Password"
    },
    {
