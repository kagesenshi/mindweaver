    {
      "itemId": 5,
      "name": "chart",
      "type": "string",
      "level": 1,
      "parent": "",
      "mandatory": false,
      "lookupSupported": true,
      "recursiveSupported": false,
      "excludesSupported": false,
      "matcher": "org.apache.ranger.plugin.resourcematcher.RangerDefaultResourceMatcher",
      "matcherOptions": {
        "wildCard": "true",
        "ignoreCase": "true"
