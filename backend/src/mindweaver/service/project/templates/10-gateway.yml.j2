apiVersion: gateway.networking.k8s.io/v1
kind: Gateway
metadata:
  name: project-gateway
  namespace: {{ namespace }}
spec:
  gatewayClassName: envoy-gateway
  infrastructure:
    parametersRef:
      group: gateway.envoyproxy.io
      kind: EnvoyProxy
      name: project-envoy-proxy-config
  listeners:
    - name: https
      protocol: HTTPS
      port: 443
      hostname: "dex.{{ ingress_domain }}"
      tls:
        mode: Terminate
        certificateRefs:
          - group: ""
            kind: Secret
            name: dex-tls
    - name: wildcard-https
      protocol: HTTPS
      port: 443
      hostname: "*.{{ ingress_domain }}"
      tls:
        mode: Terminate
        certificateRefs:
          - group: ""
            kind: Secret
            name: envoy-{{ name }}
