apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}-dex
  namespace: argocd
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: mindweaver
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ project_name }}
  source:
    repoURL: https://charts.dexidp.io
    chart: dex
    targetRevision: 0.24.1
    helm:
      values: |
        fullnameOverride: {{ name }}-dex
{{ dex_values | indent(8, true) }}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - RespectIgnoreDifferences=true
    - ServerSideApply=true
