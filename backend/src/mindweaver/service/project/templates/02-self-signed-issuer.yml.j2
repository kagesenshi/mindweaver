apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{ name }}-bootstrap-issuer
  namespace: {{ namespace }}
spec:
  selfSigned: {}
---
apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ name }}-ca-cert
  namespace: {{ namespace }}
spec:
  isCA: true
  commonName: {{ name }}-ca
  secretName: {{ name }}-ca-secret
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 2048
  issuerRef:
    name: {{ name }}-bootstrap-issuer
    kind: Issuer
    group: cert-manager.io
---
apiVersion: cert-manager.io/v1
kind: Issuer
metadata:
  name: {{ name }}-selfsigned-issuer
  namespace: {{ namespace }}
spec:
  ca:
    secretName: {{ name }}-ca-secret
