apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: dex-route
  namespace: {{ namespace }}
spec:
  parentRefs:
    - name: project-gateway
  hostnames:
    - "dex.{{ ingress_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: dex
          port: 5556
