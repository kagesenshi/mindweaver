- name: prepare-tls
  image: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}:{{ image.split(':')[-1] if ':' in image else 'latest' }}"
  command:
    - sh
    - -c
    - |
      echo "=== DEBUG INFO ==="
      whoami
      id
      ls -la /tls || true
      ls -la /tls-secret || true
      echo "=== END DEBUG INFO ==="
      cat /tls-secret/tls.key /tls-secret/tls.crt > /tls/tls.pem
      cp /tls-secret/keystore.jks /tls/keystore.jks
      
      # Find default JDK cacerts to preserve system trust anchors
      default_cacerts=""
      for path in \
        "$JAVA_HOME/lib/security/cacerts" \
        "/opt/java/openjdk/lib/security/cacerts" \
        "/usr/lib/jvm/default-jvm/lib/security/cacerts" \
        "/usr/lib/jvm/java-17-openjdk/lib/security/cacerts" \
        "/usr/lib/jvm/java-11-openjdk/lib/security/cacerts" \
        "/etc/ssl/certs/java/cacerts"; do
        if [ -f "$path" ]; then
          default_cacerts="$path"
          break
        fi
      done

      if [ -n "$default_cacerts" ]; then
        cp "$default_cacerts" /tls/truststore.jks
      else
        cp /tls-secret/truststore.jks /tls/truststore.jks 2>/dev/null || touch /tls/truststore.jks
      fi
      if [ -f /etc/ssl/certs/ca-certificates.crt ]; then
        cat /etc/ssl/certs/ca-certificates.crt > /tls/ca-certificates.crt
      elif [ -f /etc/pki/tls/certs/ca-bundle.crt ]; then
        cat /etc/pki/tls/certs/ca-bundle.crt > /tls/ca-certificates.crt
      else
        touch /tls/ca-certificates.crt
      fi
      if [ -d /trusted-certs ]; then
        for cert_file in /trusted-certs/*.crt; do
          if [ -f "$cert_file" ]; then
            alias_name=$(basename "$cert_file" .crt)
            keytool -delete -alias "$alias_name" -keystore /tls/truststore.jks -storepass changeit -noprompt || true
            keytool -importcert -alias "$alias_name" -file "$cert_file" -keystore /tls/truststore.jks -storepass changeit -noprompt
            cat "$cert_file" >> /tls/ca-certificates.crt
          fi
        done
      fi
      {% if ranger_enabled %}
      rm -f /tls/ranger-link.jceks
      echo "changeit" | keytool -importpass -alias sslKeyStore -keypass changeit -storepass changeit -keystore /tls/ranger-link.jceks -storetype JCEKS -noprompt
      echo "changeit" | keytool -importpass -alias sslTrustStore -keypass changeit -storepass changeit -keystore /tls/ranger-link.jceks -storetype JCEKS -noprompt
      {% endif %}
  volumeMounts:
    - name: tls-secret
      mountPath: /tls-secret
      readOnly: true
    - name: certs
      mountPath: /tls
    {% if trusted_certs %}
    - name: trusted-certs
      mountPath: /trusted-certs
      readOnly: true
    {% endif %}
