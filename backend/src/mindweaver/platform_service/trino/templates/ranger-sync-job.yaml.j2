apiVersion: batch/v1
kind: Job
metadata:
  name: {{ job_name }}
  namespace: {{ namespace }}
spec:
  backoffLimit: 2
  ttlSecondsAfterFinished: 300
  template:
    spec:
      restartPolicy: OnFailure
      containers:
        - name: ranger-sync
          image: python:3.11-alpine
          command:
            - python
            - -c
            - |
{{ ranger_sync_script | indent(14, True) }}
          env:
            - name: RANGER_URL
              value: "{{ ranger_url }}"
            - name: RANGER_AUTH_B64
              value: "{{ ranger_auth_b64 }}"
            - name: SERVICE_NAME
              value: "{{ service_name }}"
            - name: ACTION
              value: "{{ action }}"
            - name: RANGER_PASS
              value: "{{ ranger_pass }}"
            - name: NAMESPACE
              value: "{{ namespace }}"
