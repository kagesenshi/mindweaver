apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: 'https://trinodb.github.io/charts'
    chart: trino
    targetRevision: {{ chart_version }}
    helm:
      values: |
        {% if override_image %}
        image:
          tag: "{{ image.split(':')[-1] if ':' in image else 'latest' }}"
          repository: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}"
        {% endif %}
        {% if ranger_enabled %}
        accessControl:
          type: properties
          properties: |
            access-control.name=ranger
            ranger.service.name={{ name }}
            ranger.plugin.config.resource=/etc/trino/ranger-trino-security.xml,/etc/trino/ranger-trino-audit.xml
        {% endif %}
        additionalConfigProperties:
          {% if internal_shared_secret %}
          - internal-communication.shared-secret={{ internal_shared_secret }}
          {% endif %}
          {% if process_forwarded %}
          - http-server.process-forwarded=true
          {% endif %}
          - http-server.https.enabled=true
          - http-server.https.port=8443
          - http-server.https.keystore.path=/etc/trino/tls/tls.pem
        server:
          workers: {{ replica_count }}
          autoscaling:
            enabled: false
          {% if password_authenticator_config_files %}
          coordinatorExtraConfig: |
            http-server.authentication.type=PASSWORD
            password-authenticator.config-files={{ password_authenticator_config_files }}
          {% endif %}
        
        initContainers:
          coordinator:
            - name: prepare-tls
              image: busybox
              command:
                - sh
                - -c
                - cat /tls-secret/tls.key /tls-secret/tls.crt > /tls/tls.pem
              volumeMounts:
                - name: tls-secret
                  mountPath: /tls-secret
                  readOnly: true
                - name: certs
                  mountPath: /tls
          worker:
            - name: prepare-tls
              image: busybox
              command:
                - sh
                - -c
                - cat /tls-secret/tls.key /tls-secret/tls.crt > /tls/tls.pem
              volumeMounts:
                - name: tls-secret
                  mountPath: /tls-secret
                  readOnly: true
                - name: certs
                  mountPath: /tls

        coordinator:
          additionalExposedPorts:
            https:
              servicePort: 8443
              port: 8443
              name: https
              protocol: TCP
          additionalConfigFiles:
            {% if ldap %}
            ldap.properties: |
              password-authenticator.name=ldap
              {% for key, value in ldap.items() %}
              {{ key }}={{ value }}
              {% endfor %}
            {% endif %}
            {% if ranger_enabled %}
            file.properties: |
              password-authenticator.name=file
              file.password-file=/etc/trino/password.db
            password.db: |
              ranger:{{ ranger_trino_password_hash }}
            {% endif %}
            {% if ranger_enabled %}
            ranger-trino-security.xml: |
              <?xml version="1.0"?>
              <?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
              <configuration xmlns:xi="http://www.w3.org/2001/XInclude">
                <property>
                  <name>ranger.plugin.trino.policy.rest.url</name>
                  <value>{{ ranger_url }}</value>
                </property>
                <property>
                  <name>ranger.plugin.trino.service.name</name>
                  <value>{{ ranger_service_name }}</value>
                </property>
                <property>
                  <name>ranger.plugin.trino.policy.cache.dir</name>
                  <value>/tmp/ranger/cache</value>
                </property>
                <property>
                  <name>ranger.plugin.trino.policy.pollIntervalMs</name>
                  <value>30000</value>
                </property>
              </configuration>
            ranger-trino-audit.xml: |
              <?xml version="1.0"?>
              <?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
              <configuration xmlns:xi="http://www.w3.org/2001/XInclude">
                <property>
                  <name>xasecure.audit.is.enabled</name>
                  <value>true</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch</name>
                  <value>{{ ranger_opensearch_enabled }}</value>
                </property>
                {% if ranger_opensearch_enabled == 'true' %}
                <property>
                  <name>xasecure.audit.destination.elasticsearch.urls</name>
                  <value>{{ ranger_opensearch_host }}</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.port</name>
                  <value>9200</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.protocol</name>
                  <value>{{ ranger_opensearch_protocol }}</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.user</name>
                  <value>admin</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.password</name>
                  <value>{{ ranger_opensearch_password }}</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.index</name>
                  <value>ranger_audits</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.bootstrap.enabled</name>
                  <value>true</value>
                </property>
                <property>
                  <name>xasecure.audit.destination.elasticsearch.ssl.trustall</name>
                  <value>true</value>
                </property>
                {% endif %}
                <property>
                  <name>xasecure.audit.hdfs.is.enabled</name>
                  <value>false</value>
                </property>
              </configuration>
            {% endif %}
          additionalVolumes:
            - name: tls-secret
              secret:
                secretName: {{ name }}-tls
            - name: certs
              emptyDir: {}
          additionalVolumeMounts:
            - name: certs
              mountPath: /etc/trino/tls
              readOnly: false

        worker:
          additionalVolumes:
            - name: tls-secret
              secret:
                secretName: {{ name }}-tls
            - name: certs
              emptyDir: {}
          additionalVolumeMounts:
            - name: certs
              mountPath: /etc/trino/tls
              readOnly: false
        
        {% if catalogs %}
        catalogs:
          {% for catalog in catalogs %}
          {{ catalog.catalog }}: |
            {% for key, value in catalog.properties.items() %}
            {{ key }}={{ value }}
            {% endfor %}
          {% endfor %}
        {% endif %}
        
  destination:
    server: 'https://kubernetes.default.svc'
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
