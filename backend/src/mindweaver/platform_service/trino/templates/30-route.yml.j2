{% if ingress_domain %}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ name }}-route
  namespace: {{ namespace }}
spec:
  parentRefs:
    - name: project-gateway
  hostnames:
    - "{{ name }}.{{ ingress_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: {{ name }}
          port: 8443
---
apiVersion: gateway.networking.k8s.io/v1
kind: BackendTLSPolicy
metadata:
  name: {{ name }}-tls-policy
  namespace: {{ namespace }}
spec:
  targetRefs:
    - group: ""
      kind: Service
      name: {{ name }}
  validation:
    hostname: {{ name }}.{{ namespace }}.svc.cluster.local
    caCertificateRefs:
      - group: ""
        kind: Secret
        name: {{ name }}-tls
{% endif %}
