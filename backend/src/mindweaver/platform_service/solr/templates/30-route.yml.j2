{% if ingress_domain %}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ name }}-route
  namespace: {{ namespace }}
spec:
  parentRefs:
    - name: project-gateway
  hostnames:
    - "{{ name }}.{{ ingress_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: {{ name }}-solrcloud-common
          port: 80
{% endif %}
