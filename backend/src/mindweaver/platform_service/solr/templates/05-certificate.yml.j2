apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ name }}-tls
  namespace: {{ namespace }}
spec:
  secretName: {{ name }}-tls
  commonName: {{ name }}-solrcloud-common.{{ namespace }}.svc.cluster.local
  duration: 2160h # 90d
  renewBefore: 360h # 15d
  subject:
    organizations:
      - mindweaver
  isCA: false
  privateKey:
    algorithm: RSA
    encoding: PKCS1
    size: 2048
  usages:
    - server auth
    - client auth
  dnsNames:
    {% if ingress_domain %}
    - "{{ name }}.{{ ingress_domain }}"
    {% endif %}
    - {{ name }}-solrcloud-common
    - {{ name }}-solrcloud-common.{{ namespace }}
    - {{ name }}-solrcloud-common.{{ namespace }}.svc
    - {{ name }}-solrcloud-common.{{ namespace }}.svc.cluster.local
    - "{{ name }}-solrcloud-headless"
    - "{{ name }}-solrcloud-headless.{{ namespace }}"
    - "{{ name }}-solrcloud-headless.{{ namespace }}.svc"
    - "{{ name }}-solrcloud-headless.{{ namespace }}.svc.cluster.local"
    - "*.{{ name }}-solrcloud-headless"
    - "*.{{ name }}-solrcloud-headless.{{ namespace }}"
    - "*.{{ name }}-solrcloud-headless.{{ namespace }}.svc"
    - "*.{{ name }}-solrcloud-headless.{{ namespace }}.svc.cluster.local"
    - {{ name }}
    - {{ name }}.{{ namespace }}
    - {{ name }}.{{ namespace }}.svc
    - {{ name }}.{{ namespace }}.svc.cluster.local
  issuerRef:
    name: mindweaver-selfsigned-issuer
    kind: ClusterIssuer
    group: cert-manager.io
  keystores:
    pkcs12:
      create: true
      passwordSecretRef:
        name: {{ name }}-passwords
        key: pkcs12-password
