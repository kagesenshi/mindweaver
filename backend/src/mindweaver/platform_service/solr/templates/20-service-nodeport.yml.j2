apiVersion: v1
kind: Service
metadata:
  name: {{ name }}-nodeport
  namespace: {{ namespace }}
spec:
  type: NodePort
  ports:
    - port: 8983
      targetPort: 8983
      protocol: TCP
      name: https
  selector:
    solr-cloud: {{ name }}
    technology: solr-cloud
