apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: mindweaver
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ project_name }}
  source:
    repoURL: {{ chart_repo }}
    chart: {{ chart_name }}
    targetRevision: {{ chart_version }}
    helm:
      values: |
        cluster:
          fullnameOverride: {{ name }}
          nodeUserIdentityTemplate: "node-%d"
          manager: kubernetes
          pod:
            annotations:
              argocd.argoproj.io/ignore-healthcheck: "true"
          image:
            repository: "{{ image }}"
            tag: "{{ image_tag }}"
          nodeConfigGroups:
            default-group:
              isNode: true
              serviceAccountName: {{ name }}
              storageConfigs:
                - name: data
                  mountPath: "/opt/nifi/nifi-current/data"
                  pvcSpec:
                    accessModes:
                      - ReadWriteOnce
                    resources:
                      requests:
                        storage: "{{ storage_size }}"
              resourcesRequirements:
                requests:
                  cpu: "{{ cpu_request }}"
                  memory: "{{ mem_request }}Gi"
                limits:
                  cpu: "{{ cpu_limit }}"
                  memory: "{{ mem_limit }}Gi"
          nodes:
            {%- for i in range(replica_count) %}
            - id: {{ i }}
              nodeConfigGroup: default-group
            {%- endfor %}
          {%- if managed_admin_users %}
          managedAdminUsers:
            {%- for u in managed_admin_users %}
            - name: "{{ u.name }}"
              identity: "{{ u.identity }}"
            {%- endfor %}
          {%- endif %}
          {%- if managed_reader_users %}
          managedReaderUsers:
            {%- for u in managed_reader_users %}
            - name: "{{ u.name }}"
              identity: "{{ u.identity }}"
            {%- endfor %}
          {%- endif %}
          listenersConfig:
            internalListeners:
              - containerPort: 8443
                type: https
                name: https
              - containerPort: 6007
                type: cluster
                name: cluster
              - containerPort: 10000
                type: s2s
                name: s2s
              - containerPort: 6342
                type: load-balance
                name: load-balance
            sslSecrets:
              tlsSecretName: "{{ name }}-ca-secret"
              create: true
              issuerRef:
                name: {{ project_name }}-selfsigned-issuer
                kind: Issuer
                group: cert-manager.io
          externalServices:
            - name: {{ name }}-nodeport
              spec:
                type: NodePort
                portConfigs:
                  - internalListenerName: https
                    port: 8443
          nifiProperties:
            overrideConfigs: |
              nifi.sensitive.props.key=thisIsABadSensitiveKeyPassword
              nifi.security.identity.mapping.pattern.dn1=CN=([^,]*)?
              nifi.security.identity.mapping.value.dn1=$1
              nifi.security.identity.mapping.transform.dn1=NONE
              nifi.security.needClientAuth=false
              nifi.flow.configuration.file=/opt/nifi/nifi-current/data/flow.json.gz
              nifi.flow.configuration.archive.dir=/opt/nifi/nifi-current/data/archive
              nifi.database.directory=/opt/nifi/nifi-current/data/database_repository
              nifi.flowfile.repository.directory=/opt/nifi/nifi-current/data/flowfile_repository
              nifi.content.repository.directory.default=/opt/nifi/nifi-current/data/content_repository
              nifi.provenance.repository.directory.default=/opt/nifi/nifi-current/data/provenance_repository
              nifi.state.management.local.provider.directory=/opt/nifi/nifi-current/data/state
              {% if ingress_domain %}
              nifi.web.proxy.host={{ name }}.{{ ingress_domain }}:443
              {% endif %}
            webProxyHosts:
              {%- if ingress_domain %}
              - "{{ name }}.{{ ingress_domain }}"
              {%- else %}
              []
              {%- endif %}
          {%- if ldap_enabled %}
          ldapConfiguration:
            enabled: true
            url: "{{ ldap_url }}"
            searchBase: "{{ ldap_search_base }}"
            searchFilter: "{{ ldap_search_filter | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}"
            {%- if ldap_manager_dn %}
            managerDn: "{{ ldap_manager_dn | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}"
            {%- endif %}
            {%- if ldap_manager_password %}
            managerPassword: "{{ ldap_manager_password | replace('&', '&amp;') | replace('<', '&lt;') | replace('>', '&gt;') }}"
            {%- endif %}
            authenticationStrategy: "{{ ldap_authentication_strategy }}"
          {%- else %}
          singleUserConfiguration:
            enabled: true
            authorizerEnabled: true
            secretRef:
              name: "{{ name }}-single-user-credentials"
              namespace: "{{ namespace }}"
            secretKeys:
              username: "username"
              password: "password"
          {%- endif %}

          bootstrapProperties:
            overrideConfigs: |
              java.arg.addopens.exodus=--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
            nifiJvmMemory: "512m"

        {%- if not ldap_enabled %}
        extraManifests:
          - apiVersion: v1
            kind: Secret
            metadata:
              name: "{{ name }}-single-user-credentials"
              namespace: "{{ namespace }}"
            type: Opaque
            stringData:
              username: "admin"
              password: "admin-password-123"
        {%- endif %}
  destination:
    server: https://kubernetes.default.svc
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
