{% if ingress_domain %}
apiVersion: gateway.networking.k8s.io/v1
kind: HTTPRoute
metadata:
  name: {{ name }}-route
  namespace: {{ namespace }}
spec:
  parentRefs:
    - name: project-gateway
  hostnames:
    - "{{ name }}.{{ ingress_domain }}"
  rules:
    - matches:
        - path:
            type: PathPrefix
            value: /
      backendRefs:
        - name: {{ name }}-nodeport
          port: 8443
---
apiVersion: gateway.networking.k8s.io/v1alpha3
kind: BackendTLSPolicy
metadata:
  name: {{ name }}-tls-policy
  namespace: {{ namespace }}
spec:
  targetRefs:
    - group: ""
      kind: Service
      name: {{ name }}-nodeport
  validation:
    hostname: {{ name }}-headless.{{ namespace }}.svc.cluster.local
    caCertificateRefs:
      - group: ""
        kind: Secret
        name: {{ project_name }}-ca-secret
{% endif %}
