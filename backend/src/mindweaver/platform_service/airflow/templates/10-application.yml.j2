apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: mindweaver
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ project_name }}
  source:
    repoURL: {{ chart_repo }}
    chart: {{ chart_name }}
    targetRevision: {{ chart_version }}
    helm:
      values: |
        images:
          airflow:
            {% if override_image %}
            repository: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}"
            tag: "{{ image.split(':')[-1] if ':' in image else 'latest' }}"
            {% else %}
            repository: ghcr.io/kagesenshi/mindweaver/airflow
            tag: 3.2.2-rev.9
            {% endif %}
            pullPolicy: IfNotPresent

        executor: "{{ executor }}"

        data:
          metadataConnection:
            protocol: postgresql
            user: "{{ db_user }}"
            pass: "{{ db_pass }}"
            host: "{{ db_host }}"
            port: {{ db_port }}
            db: "{{ db_name }}"
            sslmode: disable
          brokerUrlSecretName: {{ name }}-broker-url

        fernetKeySecretName: {{ name }}-fernet-key
        apiSecretKey: "{{ webserver_secret_key }}"

        apiServer:
          service:
            type: NodePort
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi
          livenessProbe:
            initialDelaySeconds: 120
            timeoutSeconds: 30
            failureThreshold: 10
            periodSeconds: 30
            scheme: HTTP
          {% if oidc_enabled %}
          apiServerConfig: |
            import logging
            from flask_appbuilder.security.manager import AUTH_OAUTH
            
            log = logging.getLogger("airflow.security")
            
            try:
                from airflow.providers.fab.auth_manager.security_manager.override import FabAirflowSecurityManagerOverride as BaseSecurityManager
            except ImportError:
                try:
                    from airflow.providers.fab.auth_manager.security_manager import FabSecurityManager as BaseSecurityManager
                except ImportError:
                    from flask_appbuilder.security.sqla.manager import SecurityManager as BaseSecurityManager
            
            class CustomSecurityManager(BaseSecurityManager):
                def _extract_user_info(self, provider):
                    try:
                        remote_app = self.appbuilder.sm.oauth_remotes.get(provider)
                        if not remote_app:
                            log.error("DEBUG OIDC: No remote app found for provider: %s", provider)
                            return {}
                        userinfo_resp = remote_app.get('userinfo')
                        userinfo_data = userinfo_resp.json()
                        username = userinfo_data.get('preferred_username') or userinfo_data.get('sub') or userinfo_data.get('email')
                        email = userinfo_data.get('email')
                        name = userinfo_data.get('name') or username
                        first_name = userinfo_data.get('given_name') or (name.split()[0] if name else '') or username
                        last_name = userinfo_data.get('family_name') or (name.split()[1] if name and len(name.split()) > 1 else '')
                        return {
                            'username': username,
                            'email': email,
                            'first_name': first_name,
                            'last_name': last_name,
                            'role_keys': userinfo_data.get('groups', [])
                        }
                    except Exception:
                        log.exception("DEBUG OIDC: Failed to extract user info directly from provider %s", provider)
                        raise

                def oauth_user_info(self, provider, response=None):
                    func = getattr(super(), 'oauth_user_info', None)
                    if func and callable(func):
                        try:
                            user_info = func(provider, response)
                            if user_info:
                                return user_info
                        except Exception:
                            log.exception("DEBUG OIDC: super().oauth_user_info failed, falling back to direct extraction")
                    return self._extract_user_info(provider)

                def get_oauth_user_info(self, provider, response):
                    func = getattr(super(), 'get_oauth_user_info', None)
                    if func and callable(func):
                        try:
                            user_info = func(provider, response)
                            if user_info:
                                return user_info
                        except Exception:
                            log.exception("DEBUG OIDC: super().get_oauth_user_info failed, falling back to direct extraction")
                    return self._extract_user_info(provider)

            SECURITY_MANAGER_CLASS = CustomSecurityManager
            
            AUTH_TYPE = AUTH_OAUTH
            OAUTH_PROVIDERS = [
                {
                    'name': 'dex',
                    'token_key': 'access_token',
                    'icon': 'fa-key',
                    'save_token': True,
                    'remote_app': {
                        'client_id': '{{ oidc_client_id }}',
                        'client_secret': '{{ oidc_client_secret }}',
                        'api_base_url': '{{ oidc_internal_issuer }}/',
                        'access_token_url': '{{ oidc_internal_issuer }}/token',
                        'authorize_url': '{{ oidc_external_issuer }}/auth',
                        'userinfo_endpoint': '{{ oidc_internal_issuer }}/userinfo',
                        'jwks_uri': '{{ oidc_internal_issuer }}/keys',
                        'client_kwargs': {
                            'scope': 'openid email profile groups'
                        },
                    }
                }
            ]
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Viewer"
            AUTH_ROLES_SYNC_AT_LOGIN = True
            PERMANENT_SESSION_LIFETIME = 1800
          {% elif ldap %}
          {% set sf = ldap.user_search_filter %}
          {% if '{0}' in sf %}{% set sf = '' %}{% endif %}
          apiServerConfig: |
            from flask_appbuilder.security.manager import AUTH_LDAP
            AUTH_TYPE = AUTH_LDAP
            AUTH_LDAP_SERVER = "{{ ldap.server_url }}"
            AUTH_LDAP_BIND_USER = "{{ ldap.bind_dn }}"
            AUTH_LDAP_BIND_PASSWORD = "{{ ldap.bind_password }}"
            AUTH_LDAP_SEARCH = "{{ ldap.user_search_base }}"
            AUTH_LDAP_UID_FIELD = "{{ ldap.username_attr }}"
            {% if sf %}
            AUTH_LDAP_SEARCH_FILTER = "{{ sf }}"
            {% endif %}
            {% if ldap.verify_ssl %}
            AUTH_LDAP_USE_TLS = True
            {% else %}
            AUTH_LDAP_USE_TLS = False
            {% endif %}
            {% if ldap.user_group_attr %}
            AUTH_LDAP_GROUP_FIELD = "{{ ldap.user_group_attr }}"
            {% endif %}
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Admin"
            AUTH_ROLES_SYNC_AT_LOGIN = True
            PERMANENT_SESSION_LIFETIME = 1800
          {% endif %}

        workers:
          celery:
            replicas: 1
            resources:
              requests:
                cpu: {{ cpu_request }}
                memory: {{ mem_request }}Gi
              limits:
                cpu: {{ cpu_limit }}
                memory: {{ mem_limit }}Gi

        scheduler:
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        createUserJob:
          useHelmHooks: false
          applyCustomEnv: false
          jobAnnotations:
            argocd.argoproj.io/hook: Sync
            argocd.argoproj.io/hook-delete-policy: hook-succeeded
          command:
            - "bash"
            - "/opt/airflow/scripts/create-user.sh"
          args: []
          env:
            - name: AIRFLOW_PASSWORD
              value: "{{ admin_password }}"
          ttlSecondsAfterFinished: null

        migrateDatabaseJob:
          useHelmHooks: false
          jobAnnotations:
            argocd.argoproj.io/hook: Sync
            argocd.argoproj.io/hook-delete-policy: hook-succeeded
          applyCustomEnv: false
          ttlSecondsAfterFinished: null
        runAirflowMigrations: true

        postgresql:
          enabled: false

        redis:
          {% if redis_enabled %}
          enabled: true
          passwordSecretName: {{ name }}-redis-password
          {% else %}
          enabled: false
          {% endif %}

        ingress:
          enabled: false

        extraEnv: |
          - name: AIRFLOW__CORE__LOAD_EXAMPLES
            value: "{{ 'True' if load_examples else 'False' }}"
          {% if auth_role_mapping %}
          {% for entity, roles in auth_role_mapping.items() %}
          {% for role in roles %}
          - name: AIRFLOW__AUTH_ROLE_MAPPING__{{ entity | upper }}
            value: "{{ role }}"
          {% endfor %}
          {% endfor %}
          {% endif %}
          {% if s3_enabled %}
          - name: AWS_ACCESS_KEY_ID
            valueFrom:
              secretKeyRef:
                name: {{ name }}-s3
                key: AWS_ACCESS_KEY_ID
          - name: AWS_SECRET_ACCESS_KEY
            valueFrom:
              secretKeyRef:
                name: {{ name }}-s3
                key: AWS_SECRET_ACCESS_KEY
          - name: AWS_S3_ENDPOINT
            valueFrom:
              secretKeyRef:
                name: {{ name }}-s3
                key: AWS_S3_ENDPOINT
          - name: AWS_DEFAULT_REGION
            valueFrom:
              secretKeyRef:
                name: {{ name }}-s3
                key: AWS_DEFAULT_REGION
          {% endif %}

        {% if s3_enabled %}
        config:
          logging:
            remote_logging: "True"
            remote_base_log_folder: "s3://{{ logs_s3_bucket }}/logs/{{ name }}"
        {% endif %}

        {% if dags_git_sync_enabled %}
        dags:
          gitSync:
            enabled: true
            repo: "{{ dags_git_repo }}"
            branch: "{{ dags_git_branch }}"
            subPath: "{{ dags_git_subpath }}"
            wait: 60
            {% if git_repo %}
            {% if git_repo.username or git_repo.password %}
            credentialsSecret: "{{ name }}-git-sync"
            {% endif %}
            {% if ssh_key %}
            sshKeySecret: "{{ name }}-git-sync"
            knownHosts: ""
            sshKnownHosts: ""
            {% endif %}
            {% endif %}
        {% endif %}

        logs:
          persistence:
            enabled: false

  destination:
    server: 'https://kubernetes.default.svc'
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - RespectIgnoreDifferences=true
