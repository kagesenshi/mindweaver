apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  finalizers:
    - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: 'oci://ghcr.io/kagesenshi/mindweaver/charts/ranger'
    targetRevision: {{ chart_version }}
    path: .

    helm:
      values: |
        replicaCount: {{ replica_count }}
        fullnameOverride: {{ name }}
        {% if override_image %}
        image:
          repository: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}"
          tag: "{{ image.split(':')[-1] if ':' in image else 'latest' }}"
        {% endif %}
        
        # External Database Configuration
        postgresql:
          enabled: false
        db:
          type: postgres
          host: {{ db_host }}
          port: {{ db_port }}
          name: {{ db_name }}
          user: {{ db_user }}
          password: {{ db_pass }}
          rootUser: {{ db_root_user }}
          rootPassword: {{ db_root_pass }}

        # Disabled bundled components
        solr:
          enabled: false
        zookeeper:
          enabled: false

        # Admin Configuration
        admin:
          password: {{ admin_password }}
          keyadminPassword: {{ keyadmin_password }}
          tagsyncPassword: {{ tagsync_password }}
          usersyncPassword: {{ usersync_password }}
          externalUrl: https://{{ name }}.{{ namespace }}.svc.cluster.local:6080
          ssl:
            enabled: true
            keystorePassword: changeit
          javaOpts: >-
            -Djavax.net.ssl.keyStore=/etc/ranger/tls/keystore.jks
            -Djavax.net.ssl.keyStorePassword=changeit
          
          # Audit Store Configuration
          {%- if solr_id %}
          auditStore: solr
          {%- else %}
          auditStore: none
          {%- endif %}

          additionalProperties:
            {%- if not additional_properties or 'policymgr_supportedcomponents' not in additional_properties %}
            policymgr_supportedcomponents: trino,kafka,elasticsearch,nifi
            {%- endif %}
            {%- if not additional_properties or 'ranger.supportedcomponents' not in additional_properties %}
            ranger.supportedcomponents: trino,kafka,elasticsearch,nifi
            {%- endif %}
            {%- if additional_properties %}
            {%- for key, val in additional_properties.items() %}
            {{ key }}: {{ val }}
            {%- endfor %}
            {%- endif %}

        # UserSync Configuration
        usersync:
          enabled: {{ 'true' if additional_properties and additional_properties.get('SYNC_SOURCE') == 'ldap' else 'false' }}

        {%- if solr_id %}
        initContainers:
          - name: create-ranger-audits-collection
            image: curlimages/curl:8.11.0
            command:
              - sh
              - -c
              - |
                SOLR_URL="{{ solr_audit_url }}"
                ADMIN_USER="admin"
                ADMIN_PASS="{{ solr_audit_admin_password }}"
                COLLECTION="ranger_audits"

                echo "Waiting for Solr to become reachable..."
                until curl -sk -u "${ADMIN_USER}:${ADMIN_PASS}" \
                    "${SOLR_URL}/solr/admin/info/system" \
                    --max-time 5 -o /dev/null -w "%{http_code}" | grep -q "^200"; do
                  echo "Solr not ready, retrying in 5s..."
                  sleep 5
                done
                echo "Solr is ready."

                echo "Creating Solr collection '${COLLECTION}'..."
                RESPONSE=$(curl -sk -u "${ADMIN_USER}:${ADMIN_PASS}" \
                    -X POST \
                    "${SOLR_URL}/solr/admin/collections?action=CREATE&name=${COLLECTION}&numShards=1&replicationFactor=1" \
                    -w "\n%{http_code}" 2>&1)
                HTTP_CODE=$(echo "${RESPONSE}" | tail -1)
                BODY=$(echo "${RESPONSE}" | head -n -1)

                if echo "${BODY}" | grep -qi "already exists"; then
                  echo "Collection '${COLLECTION}' already exists, continuing."
                  exit 0
                elif [ "${HTTP_CODE}" = "200" ]; then
                  echo "Collection '${COLLECTION}' created successfully."
                  exit 0
                else
                  echo "Failed to create collection '${COLLECTION}'. HTTP ${HTTP_CODE}: ${BODY}"
                  exit 1
                fi
        {%- endif %}


        resources:
          requests:
            cpu: {{ cpu_request }}
            memory: {{ mem_request }}Gi
          limits:
            cpu: {{ cpu_limit }}
            memory: {{ mem_limit }}Gi

        service:
          type: NodePort
          port: 6080


  destination:
    server: https://kubernetes.default.svc
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
      - CreateNamespace=true
