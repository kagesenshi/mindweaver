apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: default
  source:
    repoURL: 'https://apache.github.io/superset'
    chart: superset
    targetRevision: {{ chart_version }}
    helm:
      values: |
        extraEnv:
          REQUESTS_CA_BUNDLE: "/etc/ssl/certs/mindweaver-ca.crt"
          SSL_CERT_FILE: "/etc/ssl/certs/mindweaver-ca.crt"

        extraVolumes:
          - name: ca-certs
            secret:
              secretName: envoy-{{ project_name }}
              items:
                - key: ca.crt
                  path: ca.crt

        extraVolumeMounts:
          - name: ca-certs
            mountPath: /etc/ssl/certs/mindweaver-ca.crt
            subPath: ca.crt
            readOnly: true

        postgresql:
          enabled: false
        
        image:
          {% if override_image %}
          repository: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}"
          tag: "{{ image.split(':')[-1] if ':' in image else 'latest' }}"
          {% else %}
          repository: ghcr.io/kagesenshi/mindweaver/superset
          tag: 5.0.0-rev.4
          {% endif %}
          pullPolicy: IfNotPresent
        
        service:
          type: NodePort
          port: 8088
          nodePort: 
            http: ~
        
        redis:
          enabled: true # Internal redis for caching/celery is fine for now
          image:
            repository: bitnamilegacy/redis
        
        supersetNode:
          connections:
            db_type: "postgresql+asyncpg"
            db_host: "{{ db_host }}"
            db_port: "{{ db_port }}"
            db_user: "{{ db_user }}"
            db_pass: "{{ db_pass }}"
            db_name: "{{ db_name }}"
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        supersetWorker:
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        init:
          adminUser:
            username: admin
            password: {{ admin_password }}
          {% if datasources %}
          loadExamples: false
          {% endif %}
          initscript: |-
            #!/bin/sh
            set -eu
            echo "Upgrading DB schema..."
            superset db upgrade
            echo "Initializing roles..."
            superset init
            if [ -f /app/configs/import_datasources.yaml ]; then
              echo "Importing datasources..."
              superset import_datasources -p /app/configs/import_datasources.yaml
              echo "Cleaning up removed datasources..."
              python3 -c "
            import yaml
            from superset.app import create_app
            app = create_app()
            with app.app_context():
                from superset import db
                from superset.models.core import Database
                with open('/app/configs/import_datasources.yaml', 'r') as f:
                    config = yaml.safe_load(f)
                expected_names = [db_entry['database_name'] for db_entry in config.get('databases', [])] + ['main', 'examples']
                for d in db.session.query(Database).all():
                    if d.database_name not in expected_names:
                        print(f'Deleting database connection: {d.database_name}')
                        db.session.delete(d)
                db.session.commit()
            "
            fi

        configOverrides:
          secret_key: |
            SECRET_KEY = '{{ superset_secret_key }}'
          {% if ldap %}
          ldap: |
            from flask_appbuilder.security.manager import AUTH_LDAP
            AUTH_TYPE = AUTH_LDAP
            AUTH_LDAP_SERVER = "{{ ldap.server_url }}"
            AUTH_LDAP_BIND_USER = "{{ ldap.bind_dn }}"
            AUTH_LDAP_BIND_PASSWORD = "{{ ldap.bind_password }}"
            AUTH_LDAP_SEARCH = "{{ ldap.user_search_base }}"
            AUTH_LDAP_UID_FIELD = "{{ ldap.username_attr }}"
            {% if ldap.user_group_attr %}
            AUTH_LDAP_GROUP_FIELD = "{{ ldap.user_group_attr }}"
            {% endif %}
            # Allow users who are authenticated via LDAP to be registered in Superset
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Public"
            AUTH_LDAP_ALLOW_LOCAL_DB = True
            PERMANENT_SESSION_LIFETIME = 1800
          {% endif %}
          {% if oidc_enabled %}
          oidc: |
            from flask_appbuilder.security.manager import AUTH_OAUTH
            AUTH_TYPE = AUTH_OAUTH
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Alpha"
            ENABLE_PROXY_FIX = True
            
            OAUTH_PROVIDERS = [
                {
                    'name': 'dex',
                    'token_key': 'access_token',
                    'icon': 'fa-key',
                    'save_token': True,
                    'remote_app': {
                        'client_id': '{{ oidc_client_id }}',
                        'client_secret': '{{ oidc_client_secret }}',
                        'api_base_url': '{{ oidc_internal_issuer }}/',
                        'access_token_url': '{{ oidc_internal_issuer }}/token',
                        'authorize_url': '{{ oidc_external_issuer }}/auth',
                        'client_kwargs': {
                            'scope': 'openid email profile groups'
                        },
                        'jwks_uri': '{{ oidc_internal_issuer }}/keys',
                    }
                }
            ]

            DATABASE_OAUTH2_UPSTREAM_PROVIDERS = {
                {% for ds in datasources %}
                {% if ds.is_trino %}
                "{{ ds.database_name }}": "dex",
                {% endif %}
                {% endfor %}
            }

            # Monkeypatch to log Trino connection details and access token
            import logging
            logger = logging.getLogger("superset.trino.monkeypatch")
            
            try:
                import trino.dbapi
                original_trino_connect = trino.dbapi.connect
                def patched_trino_connect(*args, **kwargs):
                    """Patched trino connect function to log user and auth token, and inject from session if available"""
                    from flask import session, has_request_context
                    if has_request_context():
                        token = None
                        if 'oauth_access_token' in session:
                            token = session['oauth_access_token']
                        elif 'oauth' in session:
                            oauth_data = session['oauth']
                            if isinstance(oauth_data, tuple) and len(oauth_data) > 0:
                                token = oauth_data[0]
                            elif isinstance(oauth_data, dict):
                                token = oauth_data.get('access_token') or oauth_data.get('oauth_token')
                            else:
                                token = str(oauth_data)
                        
                        if token:
                            import trino.auth
                            kwargs["auth"] = trino.auth.JWTAuthentication(token)
                            logger.info(f"[MONKEYPATCH TRINO CONNECT] Injected JWT token from Flask session for user {kwargs.get('user')}")
                        else:
                            logger.warning(f"[MONKEYPATCH TRINO CONNECT] No token found in session. Available keys: {list(session.keys())}")
                    auth = kwargs.get("auth")
                    token_str = "None"
                    if auth:
                        if hasattr(auth, "token"):
                            token_str = str(auth.token)
                        elif hasattr(auth, "_token"):
                            token_str = str(auth._token)
                        else:
                            token_str = str(auth)
                    logger.info(f"[MONKEYPATCH TRINO CONNECT] Connecting with user: {kwargs.get('user')}, auth token: {token_str}, kwargs: {kwargs}")
                    return original_trino_connect(*args, **kwargs)
                trino.dbapi.connect = patched_trino_connect
                logger.info("[MONKEYPATCH TRINO] Successfully patched trino.dbapi.connect")
            except Exception as e:
                logger.error(f"[MONKEYPATCH TRINO] Failed to patch trino.dbapi.connect: {e}")

            try:
                import trino.auth
                if hasattr(trino.auth, "JWTAuthentication"):
                    original_jwt_init = trino.auth.JWTAuthentication.__init__
                    def patched_jwt_init(self, token, *args, **kwargs):
                        """Patched JWTAuthentication init to log token"""
                        logger.info(f"[MONKEYPATCH TRINO JWT] JWTAuthentication initialized with token: {token}")
                        original_jwt_init(self, token, *args, **kwargs)
                    trino.auth.JWTAuthentication.__init__ = patched_jwt_init
                    logger.info("[MONKEYPATCH TRINO] Successfully patched trino.auth.JWTAuthentication.__init__")
            except Exception as e:
                logger.error(f"[MONKEYPATCH TRINO] Failed to patch JWTAuthentication: {e}")

            from superset.security import SupersetSecurityManager

            class CustomSecurityManager(SupersetSecurityManager):
                def _add_sql_lab_role_to_alpha(self, user):
                    if user:
                        alpha_role = self.find_role("Alpha")
                        sql_lab_role = self.find_role("sql_lab")
                        if alpha_role and sql_lab_role:
                            if alpha_role in user.roles and sql_lab_role not in user.roles:
                                user.roles.append(sql_lab_role)
                                self.get_session.commit()
                    return user

                def auth_user_oauth(self, userinfo):
                    user = super().auth_user_oauth(userinfo)
                    return self._add_sql_lab_role_to_alpha(user)

                def auth_user_ldap(self, username, password):
                    user = super().auth_user_ldap(username, password)
                    return self._add_sql_lab_role_to_alpha(user)

                def auth_user_db(self, username, password):
                    user = super().auth_user_db(username, password)
                    return self._add_sql_lab_role_to_alpha(user)

                def oauth_user_info(self, provider, response=None):
                    import logging
                    logging.info(f"[DEBUG OIDC] Response from provider {provider}: {response}")
                    if provider == 'dex' and response:
                        from flask import session
                        if 'access_token' in response:
                            session['oauth_access_token'] = response['access_token']
                    if provider == 'dex':
                        remote_app = self.oauth_remotes.get(provider)
                        if remote_app and response:
                            # 1. Try parsing OIDC ID token first
                            try:
                                data = remote_app.parse_id_token(response)
                                if data:
                                    return {
                                        'username': data.get('preferred_username') or data.get('email') or data.get('sub'),
                                        'name': data.get('name'),
                                        'email': data.get('email'),
                                        'first_name': data.get('given_name') or data.get('name') or '',
                                        'last_name': data.get('family_name') or '',
                                        'role_keys': data.get('groups', []),
                                    }
                            except Exception as e:
                                import logging
                                logging.warning(f"Failed to parse OIDC ID token: {e}")

                            # 2. Fallback to userinfo endpoint with explicit token
                            try:
                                me = remote_app.get('userinfo', token=response)
                                if me and me.status_code == 200:
                                    data = me.json()
                                    return {
                                        'username': data.get('preferred_username') or data.get('email') or data.get('sub'),
                                        'name': data.get('name'),
                                        'email': data.get('email'),
                                        'first_name': data.get('given_name') or data.get('name') or '',
                                        'last_name': data.get('family_name') or '',
                                        'role_keys': data.get('groups', []),
                                    }
                            except Exception as e:
                                import logging
                                logging.error(f"Failed to fetch userinfo from Dex: {e}")
                    return super().oauth_user_info(provider, response)

            CUSTOM_SECURITY_MANAGER = CustomSecurityManager

            import trino.auth
            ALLOWED_EXTRA_AUTHENTICATIONS = {
                "trino": {
                    "jwt": trino.auth.JWTAuthentication
                }
            }
          {% endif %}
          {% if auth_role_mapping %}
          role_mapping: |
            AUTH_ROLES_MAPPING = {
              {% for entity, roles in auth_role_mapping.items() %}
              "{{ entity }}": {{ roles | tojson }},
              {% endfor %}
            }

            AUTH_ROLES_SYNC_AT_LOGIN = True
          {% endif %}

        {% if datasources %}
        extraConfigs:
          import_datasources.yaml: |
            databases:
            {% for ds in datasources %}
            - database_name: "{{ ds.database_name }}"
              sqlalchemy_uri: "{{ ds.sqlalchemy_uri }}"
              expose_in_sqllab: true
              {% if ds.impersonate_user %}
              impersonate_user: true
              {% endif %}
              {% if ds.extra %}
              extra: |
                {{ ds.extra | tojson }}
              {% endif %}
            {% endfor %}
        {% endif %}


  destination:
    server: 'https://kubernetes.default.svc'
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
