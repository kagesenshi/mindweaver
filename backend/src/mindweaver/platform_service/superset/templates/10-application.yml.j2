apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: {{ name }}
  namespace: argocd
  labels:
    {% if project_title %}
    project: "{{ project_title }}"
    {% endif %}
    {% if service_title %}
    service: "{{ service_title }}"
    {% endif %}
    manager: mindweaver
  finalizers:
  - resources-finalizer.argocd.argoproj.io
spec:
  project: {{ project_name }}
  source:
    repoURL: {{ chart_repo }}
    chart: {{ chart_name }}
    targetRevision: {{ chart_version }}
    helm:
      values: |
        extraEnv:
          REQUESTS_CA_BUNDLE: "/etc/ssl/certs/mindweaver-ca.crt"
          SSL_CERT_FILE: "/etc/ssl/certs/mindweaver-ca.crt"

        extraVolumes:
          - name: ca-certs
            secret:
              secretName: {{ name }}-tls
              items:
                - key: ca.crt
                  path: ca.crt
                - key: tls.crt
                  path: tls.crt
                - key: tls.key
                  path: tls.key

        extraVolumeMounts:
          - name: ca-certs
            mountPath: /etc/ssl/certs/mindweaver-ca.crt
            subPath: ca.crt
            readOnly: true
          - name: ca-certs
            mountPath: /etc/superset/trino-certs/tls.crt
            subPath: tls.crt
            readOnly: true
          - name: ca-certs
            mountPath: /etc/superset/trino-certs/tls.key
            subPath: tls.key
            readOnly: true

        postgresql:
          enabled: false
        
        image:
          {% if override_image %}
          repository: "{{ image.rsplit(':', 1)[0] if ':' in image else image }}"
          tag: "{{ image.split(':')[-1] if ':' in image else 'latest' }}"
          {% else %}
          repository: ghcr.io/kagesenshi/mindweaver/superset
          tag: 6.1.0-rev.1
          {% endif %}
          pullPolicy: IfNotPresent
        
        service:
          type: NodePort
          port: 8088
          nodePort: 
            http: ~
        
        redis:
          enabled: true # Internal redis for caching/celery is fine for now
          image:
            repository: bitnamilegacy/redis
        
        supersetNode:
          connections:
            db_type: "postgresql+asyncpg"
            db_host: "{{ db_host }}"
            db_port: "{{ db_port }}"
            db_user: "{{ db_user }}"
            db_pass: "{{ db_pass }}"
            db_name: "{{ db_name }}"
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        supersetWorker:
          resources:
            requests:
              cpu: {{ cpu_request }}
              memory: {{ mem_request }}Gi
            limits:
              cpu: {{ cpu_limit }}
              memory: {{ mem_limit }}Gi

        init:
          adminUser:
            username: admin
            password: {{ admin_password }}
          loadExamples: {{ 'true' if load_examples else 'false' }}
          initscript: |-
            #!/bin/sh
            set -eu
            echo "Upgrading DB schema..."
            superset db upgrade
            echo "Initializing roles..."
            superset init
            if [ -f /app/configs/import_datasources.yaml ]; then
              echo "Importing datasources..."
              superset import_datasources -p /app/configs/import_datasources.yaml
            fi
            echo "Cleaning up removed datasources..."
            python3 -c "
            import os
            import yaml
            from superset.app import create_app
            app = create_app()
            with app.app_context():
                from superset import db
                from superset.models.core import Database
                expected_names = ['main', 'examples']
                config_path = '/app/configs/import_datasources.yaml'
                if os.path.exists(config_path):
                    with open(config_path, 'r') as f:
                        config = yaml.safe_load(f) or {}
                    expected_names.extend([db_entry['database_name'] for db_entry in config.get('databases', [])])
                for d in db.session.query(Database).all():
                    if d.database_name not in expected_names:
                        print(f'Deleting database connection: {d.database_name}')
                        db.session.delete(d)
                db.session.commit()
            "

        configOverrides:
          secret_key: |
            SECRET_KEY = '{{ superset_secret_key }}'
            RECAPTCHA_PUBLIC_KEY = ''
            RECAPTCHA_PRIVATE_KEY = ''
          {% if ldap %}
          ldap: |
            from flask_appbuilder.security.manager import AUTH_LDAP
            AUTH_TYPE = AUTH_LDAP
            AUTH_LDAP_SERVER = "{{ ldap.server_url }}"
            AUTH_LDAP_BIND_USER = "{{ ldap.bind_dn }}"
            AUTH_LDAP_BIND_PASSWORD = "{{ ldap.bind_password }}"
            AUTH_LDAP_SEARCH = "{{ ldap.user_search_base }}"
            AUTH_LDAP_UID_FIELD = "{{ ldap.username_attr }}"
            {% if ldap.user_group_attr %}
            AUTH_LDAP_GROUP_FIELD = "{{ ldap.user_group_attr }}"
            {% endif %}
            # Allow users who are authenticated via LDAP to be registered in Superset
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Alpha"
            AUTH_LDAP_ALLOW_LOCAL_DB = True
            PERMANENT_SESSION_LIFETIME = 1800
          {% endif %}
          {% if oidc_enabled %}
          oidc: |
            from flask_appbuilder.security.manager import AUTH_OAUTH
            AUTH_TYPE = AUTH_OAUTH
            AUTH_USER_REGISTRATION = True
            AUTH_USER_REGISTRATION_ROLE = "Alpha"
            ENABLE_PROXY_FIX = True
            
            OAUTH_PROVIDERS = [
                {
                    'name': 'dex',
                    'token_key': 'access_token',
                    'icon': 'fa-key',
                    'save_token': True,
                    'remote_app': {
                        'client_id': '{{ oidc_client_id }}',
                        'client_secret': '{{ oidc_client_secret }}',
                        'api_base_url': '{{ oidc_internal_issuer }}/',
                        'access_token_url': '{{ oidc_internal_issuer }}/token',
                        'authorize_url': '{{ oidc_external_issuer }}/auth',
                        'client_kwargs': {
                            'scope': 'openid email profile groups'
                        },
                        'jwks_uri': '{{ oidc_internal_issuer }}/keys',
                    }
                }
            ]

            from superset.security import SupersetSecurityManager

            class CustomSecurityManager(SupersetSecurityManager):
                def update_user_auth_stat(self, user, success=True):
                    if success and user:
                        try:
                            {% if sqllab_enabled %}
                            sql_lab_role = self.find_role("sql_lab")
                            if sql_lab_role and sql_lab_role not in user.roles:
                                user.roles.append(sql_lab_role)
                                try:
                                    self.session.commit()
                                except AttributeError:
                                    from superset import db
                                    db.session.commit()
                            {% endif %}
                        except Exception as e:
                            import logging
                            logging.error(f"Failed to auto-assign sql_lab role: {e}")
                    super().update_user_auth_stat(user, success)

                def oauth_user_info(self, provider, response=None):
                    if provider == 'dex':
                        remote_app = self.oauth_remotes.get(provider)
                        if remote_app and response:
                            # 1. Try using already parsed userinfo in response
                            data = response.get('userinfo')
                            if data:
                                return {
                                    'username': data.get('preferred_username') or data.get('email') or data.get('sub'),
                                    'name': data.get('name'),
                                    'email': data.get('email'),
                                    'first_name': data.get('given_name') or data.get('name') or '',
                                    'last_name': data.get('family_name') or '',
                                    'role_keys': data.get('groups', []),
                                }

                            # 2. Try parsing OIDC ID token
                            try:
                                from flask import session
                                nonce = session.get(f"_{provider}_authlib_nonce_")
                                data = remote_app.parse_id_token(response, nonce=nonce)
                                if data:
                                    return {
                                        'username': data.get('preferred_username') or data.get('email') or data.get('sub'),
                                        'name': data.get('name'),
                                        'email': data.get('email'),
                                        'first_name': data.get('given_name') or data.get('name') or '',
                                        'last_name': data.get('family_name') or '',
                                        'role_keys': data.get('groups', []),
                                    }
                            except Exception as e:
                                import logging
                                logging.warning(f"Failed to parse OIDC ID token: {e}")

                            # 3. Fallback to userinfo endpoint with explicit token
                            try:
                                me = remote_app.get('userinfo', token=response)
                                if me and me.status_code == 200:
                                    data = me.json()
                                    return {
                                        'username': data.get('preferred_username') or data.get('email') or data.get('sub'),
                                        'name': data.get('name'),
                                        'email': data.get('email'),
                                        'first_name': data.get('given_name') or data.get('name') or '',
                                        'last_name': data.get('family_name') or '',
                                        'role_keys': data.get('groups', []),
                                    }
                            except Exception as e:
                                import logging
                                logging.error(f"Failed to fetch userinfo from Dex: {e}")
                    return super().oauth_user_info(provider, response)

            CUSTOM_SECURITY_MANAGER = CustomSecurityManager

            import trino.auth
            ALLOWED_EXTRA_AUTHENTICATIONS = {
                "trino": {
                    "jwt": trino.auth.JWTAuthentication,
                    "certificate": trino.auth.CertificateAuthentication
                }
            }
          {% endif %}
          {% if auth_role_mapping %}
          role_mapping: |
            AUTH_ROLES_MAPPING = {
              {% for entity, roles in auth_role_mapping.items() %}
              "{{ entity }}": {{ roles | tojson }},
              {% endfor %}
            }

            AUTH_ROLES_SYNC_AT_LOGIN = True
          {% endif %}
          {% if ldap or oidc_enabled %}
          bootstrap_overrides: |
            from flask_appbuilder.security.manager import AUTH_LDAP, AUTH_OAUTH

            def common_bootstrap_overrides(bootstrap_data: dict) -> dict:
                conf = bootstrap_data.get("conf", {})
                if conf.get("AUTH_TYPE") in (AUTH_LDAP, AUTH_OAUTH):
                    return {
                        **bootstrap_data,
                        "conf": {
                            **conf,
                            "AUTH_USER_REGISTRATION": False,
                        },
                    }
                return bootstrap_data

            COMMON_BOOTSTRAP_OVERRIDES_FUNC = common_bootstrap_overrides
          {% endif %}

        {% if datasources %}
        extraConfigs:
          import_datasources.yaml: |
            databases:
            {% for ds in datasources %}
            - database_name: "{{ ds.database_name }}"
              sqlalchemy_uri: "{{ ds.sqlalchemy_uri }}"
              expose_in_sqllab: true
              {% if ds.impersonate_user %}
              impersonate_user: true
              {% endif %}
              {% if ds.extra %}
              extra: |
                {{ ds.extra | tojson }}
              {% endif %}
              {% if ds.encrypted_extra %}
              encrypted_extra: |
                {{ ds.encrypted_extra | tojson }}
              {% endif %}
            {% endfor %}
        {% endif %}


  destination:
    server: 'https://kubernetes.default.svc'
    namespace: {{ namespace }}
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
